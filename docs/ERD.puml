@startuml ERD

hide circles
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 100


' 1. Роли
entity "user_roles" as roles {
    * user_role_id : INTEGER <<PK>>
    --
    * name : TEXT (UNIQUE)
}

' 2. Пользователи
entity "users" as users {
    * user_id : INTEGER <<PK>>
    --
    * name : TEXT
    * surname : TEXT
    * patronymic : TEXT
    * login : TEXT (UNIQUE)
    * password : TEXT
    * user_role : INTEGER <<FK>>
}

' 3. Устройства пользователей (Связь 1:1)
entity "users_device" as devices {
    * device_id : INTEGER <<PK>>
    --
    * user_id : INTEGER <<FK, UNIQUE>>
    * name : TEXT
}

' 4. Категории заявок
entity "ticket_categories" as categories {
    * category_id : INTEGER <<PK>>
    --
    * name : TEXT (UNIQUE)
}

' 5. Статусы заявок
entity "ticket_status" as statuses {
    * ticket_status_id : INTEGER <<PK>>
    --
    * name : TEXT (UNIQUE)
}

' 6. Таблица заявок
entity "tickets" as tickets {
    * ticket_id : INTEGER <<PK>>
    --
    * ticket_category_id : INTEGER <<FK>>
    * ticket_description : TEXT
    * current_status : TEXT <<FK>>
    * ticket_created_time : DATETIME
    * created_updated_time : DATETIME
    * user_id : INTEGER <<FK>>
    executor_id : INTEGER <<FK>>
}

' 7. Таблица сообщений
entity "messages_in_tickets" as messages {
    * message_id : INTEGER <<PK>>
    --
    * ticket_id : INTEGER <<FK>>
    * sender_id : INTEGER <<FK>>
    * message_text : TEXT
    * written_time : DATETIME
}

' Роли к Пользователям (1:N)
roles ||--{ users : "1:N"

' Пользователь к Устройству (1:1)
users ||--|| devices : "1:1"

' Категория к Заявкам (1:N)
categories ||--{ tickets : "1:N"

' Статус к Заявкам (1:N)
statuses ||--{ tickets : "1:N"

' Пользователь (Клиент) к Заявкам (1:N)
users ||--{ tickets : "1:N"

' Пользователь (Исполнитель) к Заявкам (1:0..* - может быть не назначен)
users ||--o{ tickets : "1:0..*"

' Заявка к Сообщениям (1:N)
tickets ||--{ messages : "1:N"

' Пользователь к Сообщениям (1:N)
users ||--{ messages : "1:N"

@enduml
